{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/grade.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 15
    },
    "api/speech-token.ts": {
      "maxDuration": 10
    },
    "api/ingest.ts": {
      "maxDuration": 300
    },
    "api/chunk.ts": {
      "maxDuration": 60
    },
    "api/suggest.ts": {
      "maxDuration": 60
    }
  }
}
